# ==========================================
# CUSTOM GITIGNORE TEMPLATE
# ==========================================

# --- System Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Environment & Sensitive Data (NEVER COMMIT) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.secret
credentials.json

# --- Dependencies & Package Managers ---
node_modules/
jspm_packages/
web_modules/
.npm/
.yarn/
bun.lockb

# --- Build Outputs & Artifacts ---
dist/
build/
out/
bin/
obj/
*.exe
*.dll
*.so
*.dylib
*.war
*.ear
*.zip
*.tar.gz
*.rar

# --- Logs and Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Editors and IDEs ---
# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# IntelliJ / WebStorm / PyCharm
.idea/
*.iws
*.iml
*.ipr

# Xcode
*.xcuserstate
derivedData/

# --- Testing & Coverage ---
coverage/
.nyc_output/
htmlcov/
.tox/
.pytest_cache/

# --- Local & Personal Configurations ---
.local
*.tmp
*.bak
